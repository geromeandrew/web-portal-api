{
  "name": "web-portal-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "node --watch --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "node --env-file=.env dist/migrate.js",
    "db:migrate:local": "node --env-file=.env --import tsx src/migrate.ts",
    "db:migrate:prepaid": "node --env-file=.env dist/migratePrepaid.js",
    "db:migrate:prepaid:local": "node --env-file=.env --import tsx src/migratePrepaid.ts",
    "worker:prepaid": "node --env-file=.env dist/prepaidWorker.js",
    "worker:prepaid:local": "node --env-file=.env --import tsx src/prepaidWorker.ts",
    "deploy:prepaid:sources": "node --env-file=.env --import tsx src/deployPrepaidSources.ts",
    "verify:prepaid:sources": "node --env-file=.env --import tsx src/deployPrepaidSources.ts",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json compose.yml compose.deploy.yml",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json compose.yml compose.deploy.yml"
  },
  "dependencies": {
    "@aws-sdk/client-glue": "^3.1152.0",
    "@aws-sdk/client-rds-data": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.991.0",
    "@aws-sdk/client-sfn": "^3.1100.0",
    "@aws-sdk/client-sts": "^3.1100.0",
    "@okta/jwt-verifier": "^4.0.2",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.1",
    "fflate": "0.8.2",
    "helmet": "8.3.0",
    "hpp": "0.2.3",
    "multer": "^2.0.2",
    "permissions-policy": "0.6.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-types": "^12.1.3",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.2"
}

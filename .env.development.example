NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:replace-with-uri-encoded-rds-password@database-1-instance-1.c0x8ko8cis42.us-east-1.rds.amazonaws.com:5432/postgres
DATABASE_SCHEMA=web_portal
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-bootstrap-password
LAMBDA_UPLOAD_URL=https://your-function-id.lambda-url.ap-southeast-1.on.aws

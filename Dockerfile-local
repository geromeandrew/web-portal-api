FROM node:22-alpine AS dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS build
COPY tsconfig.json ./
COPY src ./src
RUN pnpm build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile && pnpm store prune
RUN apk add --no-cache python3 py3-pip
COPY infrastructure/prepaid/requirements-backend.txt ./infrastructure/prepaid/
RUN python3 -m venv /app/.venv-prepaid && /app/.venv-prepaid/bin/pip install --no-cache-dir -r infrastructure/prepaid/requirements-backend.txt
COPY infrastructure/prepaid/normalize_source.py infrastructure/prepaid/portal_source_extract.py ./infrastructure/prepaid/
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "dist/index.js"]
